<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@color/background">

    <!-- Welcome TextView -->
    <TextView
        android:id="@+id/homeWelcomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_welcome_text"
        android:textSize="24sp"
        android:textColor="@color/primary"
        android:layout_marginBottom="16dp" />

    <!-- Location Details -->
    <TextView
        android:id="@+id/homeLocationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location details will appear here"
        android:textSize="16sp"
        android:textColor="@color/onBackground"
        android:paddingBottom="16dp" />

    <!-- Show College Button -->
    <Button
        android:id="@+id/showCollegeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show TUD CQ Location"
        android:backgroundTint="@color/secondary"
        android:textColor="@color/onSecondary" />

    <!-- CardView -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/surface">

        <!-- Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Captured Image -->
            <ImageView
                android:id="@+id/idCardImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/profile_image_description"
                android:scaleType="centerCrop"
                android:background="@color/primaryVariant" />

            <!-- Student Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/studentNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/student_name_placeholder"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/onBackground"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/studentIdTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/student_id_placeholder"
                    android:textSize="16sp"
                    android:textColor="@color/onBackground" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
