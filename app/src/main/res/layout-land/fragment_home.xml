<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Left Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <!-- Welcome TextView -->
            <TextView
                android:id="@+id/homeWelcomeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_welcome_text"
                android:textSize="24sp"
                android:textColor="@color/primary"
                android:layout_marginBottom="16dp" />

            <!-- Location Details -->
            <TextView
                android:id="@+id/homeLocationTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="Location details will appear here"
                android:textSize="16sp"
                android:textColor="@color/onBackground" />

            <!-- Show College Button -->
            <Button
                android:id="@+id/showCollegeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show TUD CQ Location"
                android:backgroundTint="@color/secondary"
                android:textColor="@color/onSecondary"
                android:layout_gravity="center" />
        </LinearLayout>

        <!-- Right Column -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface">

            <!-- Profile Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Captured Image -->
                <ImageView
                    android:id="@+id/idCardImageView"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/primaryVariant"
                    android:contentDescription="@string/profile_image_description"
                    android:scaleType="centerCrop" />

                <!-- Student Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/studentNameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/student_name_placeholder"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/onBackground"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/studentIdTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/student_id_placeholder"
                        android:textSize="16sp"
                        android:textColor="@color/onBackground" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
